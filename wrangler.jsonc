{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jumby",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": ".next",
  // NOTE: D1/R2/KV bindings below are declared for the planned Cloudflare
  // persistence layer but are not yet referenced by application code —
  // the app currently persists to the local filesystem (public/games +
  // src/data/published-games.json). See migrations/0001_initial_schema.sql.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jumby-db",
      "database_id": "local-jumby-db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "GAMES_BUCKET",
      "bucket_name": "jumby-games"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "local-jumby-kv"
    }
  ]
}
